      "expected": {
        "state": [],
        "layers": [
          {
            "id": "back_bg",
            "texture": "common/back_bg.png",
            "x": 151,
            "y": 17
          },
          {
            "id": "back_icon",
            "texture": "shop/custom_back.png",
            "x": 153,
            "y": 19
          },
          {
            "id": "background",
            "texture": "shop/background.png",
            "x": 0,
            "y": 0
          }
        ],
        "texts": [],
        "slots": [
          {
            "id": "back",
            "kind": "button",
            "col": 8,
            "row": 0,
            "width": 1,
            "height": 1,
            "actions": [
              "close"
            ]
          }
        ]
      }
    },
    {
      "name": "gabarit, composants imbriqués et deux instances préfixées",
      "resolve": "profile",
      "menus": [
        {
          "formatVersion": 1,
          "id": "frame",
          "name": "Cadre",
          "template": true,
          "state": {
            "tab": {
              "type": "enum",
              "values": [
                "home",
                "stats"
              ],
              "default": "home"
            }
          },
          "layers": [
            {
              "id": "frame",
              "texture": "frame.png",
              "x": 0,
              "y": 0
            }
          ]
        },
        {
          "formatVersion": 1,
          "id": "tab_button",
          "name": "Bouton d’onglet",
          "component": true,
          "layers": [
            {
              "id": "bg",
              "texture": "tab.png",
              "x": 7,
              "y": 15
            }
          ],
          "slots": [
            {
              "id": "button",
              "kind": "button",
              "area": {
                "col": 0,
                "row": 0
              }
            }
          ]
        },
        {
          "formatVersion": 1,
          "id": "tab_bar",
          "name": "Barre d’onglets",
          "component": true,
          "extends": [
            "frame"
          ],
          "includes": [
            {
              "component": "tab_button",
              "prefix": "home_"
            },
            {
              "component": "tab_button",
              "prefix": "stats_",
              "col": 1,
              "visibleWhen": {
                "not": {
                  "state": "tab",
                  "is": "home"
                }
              }
            }
          ],
          "texts": [
            {
              "id": "caption",
              "x": 8,
              "y": 6,
              "value": "Onglets"
            }
          ]
        },
        {
          "formatVersion": 1,
          "id": "profile",
          "name": "Profil",
          "extends": [
            "frame"
          ],
          "state": {
            "tab": {
              "type": "enum",
              "values": [
                "home",
                "stats",
                "badges"
              ],
              "default": "home"
            }
          },
          "includes": [
            {
              "component": "tab_bar",
              "prefix": "bar_",
              "row": 1
            }
          ],
          "layers": [
            {
              "id": "portrait",
              "texture": "profile/portrait.png",
              "x": 60,
              "y": 40,
              "visibleWhen": {
                "state": "tab",
                "in": [
                  "home",
                  "badges"
                ]
              }
            }
          ]
        }
      ],
      "expected": {
        "state": [
          [
            "tab",
            "enum"
          ]
        ],
        "layers": [
          {
            "id": "frame",
            "texture": "frame.png",
            "x": 0,
            "y": 0
          },
          {
            "id": "bar_frame",
            "texture": "frame.png",
            "x": 0,
            "y": 18
          },
          {
            "id": "bar_home_bg",
            "texture": "tab.png",
            "x": 7,
            "y": 33
          },
          {
            "id": "bar_stats_bg",
            "texture": "tab.png",
            "x": 25,
            "y": 33,
            "visibleWhen": {
              "not": {
                "state": "tab",
                "is": "home"
              }
            }
          },
          {
            "id": "portrait",
            "texture": "profile/portrait.png",
            "x": 60,
            "y": 40,
            "visibleWhen": {
              "state": "tab",
              "in": [
                "home",
                "badges"
              ]
            }
          }
        ],
        "texts": [
          {
            "id": "bar_caption",
            "x": 8,
            "y": 24,
            "value": "Onglets"
          }
        ],
        "slots": [
          {
            "id": "bar_home_button",
            "kind": "button",
            "col": 0,
            "row": 1,
            "width": 1,
            "height": 1,
            "actions": []
          },
          {
            "id": "bar_stats_button",
            "kind": "button",
            "col": 1,
            "row": 1,
            "width": 1,
            "height": 1,
            "actions": [],
            "visibleWhen": {
              "not": {
                "state": "tab",
                "is": "home"
              }
            }
          }
        ]
      }
