{
  "description": "Composants (includes) : décalage en cases et en pixels, préfixe, condition d’instance, surcharge par id, état fusionné, composants imbriqués, erreurs.",
  "cases": [
    {
      "name": "instance décalée, préfixée et conditionnée",
      "resolve": "shop",
      "menus": [
        {
          "formatVersion": 1,
          "id": "pager",
          "name": "Pagination",
          "component": true,
          "state": {
            "page": {
              "type": "page",
              "list": "items"
            }
          },
          "layers": [
            {
              "id": "prev_on",
              "texture": "pager/prev_on.png",
              "x": 25,
              "y": 107,
              "visibleWhen": {
                "flag": "page.hasPrev"
              }
            },
            {
              "id": "next_on",
              "texture": "pager/next_on.png",
              "x": 133,
              "y": 107,
              "visibleWhen": {
                "flag": "page.hasNext"
              }
            }
          ],
          "texts": [
            {
              "id": "label",
              "x": 88,
              "y": 111,
              "align": "center",
              "value": "{page.number}/{page.count}"
            }
          ],
          "slots": [
            {
              "id": "prev",
              "kind": "button",
              "area": {
                "col": 1,
                "row": 5
              },
              "onClick": [
                {
                  "type": "prevPage",
                  "list": "items"
                }
              ]
            },
            {
              "id": "next",
              "kind": "button",
              "area": {
                "col": 7,
                "row": 5
              },
              "enabledWhen": {
                "flag": "page.hasNext"
              },
              "onClick": [
                {
                  "type": "nextPage",
                  "list": "items"
                }
              ]
            }
          ]
        },
        {
          "formatVersion": 1,
          "id": "shop",
          "name": "Boutique",
          "container": {
            "type": "chest",
            "rows": 6
          },
          "state": {
            "tab": {
              "type": "enum",
              "values": [
                "food",
                "tools"
              ],
              "default": "food"
            }
          },
          "includes": [
            {
              "component": "pager",
              "prefix": "pager_",
              "row": -1,
              "x": 1,
              "y": 2,
              "visibleWhen": {
                "state": "tab",
                "is": "food"
              }
            }
          ],
          "layers": [
            {
              "id": "background",
              "texture": "shop/background.png",
              "x": 0,
              "y": 0
            }
          ],
          "slots": [
            {
              "id": "grid",
              "kind": "list",
              "list": "items",
              "area": {
                "col": 1,
                "row": 1,
                "width": 7,
                "height": 3
              }
            }
          ]
        }
      ],
      "expected": {
        "state": [
          [
            "page",
            "page"
          ],
          [
            "tab",
            "enum"
          ]
        ],
        "layers": [
          {
            "id": "pager_prev_on",
            "texture": "pager/prev_on.png",
            "x": 26,
            "y": 91,
            "visibleWhen": {
              "all": [
                {
                  "state": "tab",
                  "is": "food"
                },
                {
                  "flag": "page.hasPrev"
                }
              ]
            }
          },
          {
            "id": "pager_next_on",
            "texture": "pager/next_on.png",
            "x": 134,
            "y": 91,
            "visibleWhen": {
              "all": [
                {
                  "state": "tab",
                  "is": "food"
                },
                {
                  "flag": "page.hasNext"
                }
              ]
            }
          },
          {
            "id": "background",
            "texture": "shop/background.png",
            "x": 0,
            "y": 0
          }
        ],
        "texts": [
          {
            "id": "pager_label",
            "x": 89,
            "y": 95,
            "value": "{page.number}/{page.count}",
            "visibleWhen": {
              "state": "tab",
              "is": "food"
            }
          }
        ],
        "slots": [
          {
            "id": "pager_prev",
            "kind": "button",
            "col": 1,
            "row": 4,
            "width": 1,
            "height": 1,
            "actions": [
              "prevPage"
            ],
            "visibleWhen": {
              "state": "tab",
              "is": "food"
            }
          },
          {
            "id": "pager_next",
            "kind": "button",
            "col": 7,
            "row": 4,
            "width": 1,
            "height": 1,
            "actions": [
              "nextPage"
            ],
            "visibleWhen": {
              "state": "tab",
              "is": "food"
            },
            "enabledWhen": {
              "flag": "page.hasNext"
            }
          },
          {
            "id": "grid",
            "kind": "list",
            "col": 1,
            "row": 1,
            "width": 7,
            "height": 3,
            "actions": []
          }
        ]
      }
    },
