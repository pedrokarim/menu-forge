{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Menu Forge",
  "version": "0.1.0",
  "identifier": "eu.enderium.menuforge",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Studio d’inventaires Minecraft custom",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../templates/": "templates/"
    },
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
