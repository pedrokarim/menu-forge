{
  "name": "studio",
  "private": true,
  "version": "0.0.0",
  "description": "Studio menu-forge : éditeur local d’inventaires Minecraft custom (interface React, backend Rust, coquille Tauri).",
  "license": "MIT",
  "homepage": "https://pedrokarim.github.io/menu-forge/",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrokarim/menu-forge.git",
    "directory": "studio"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-rust.mjs",
    "dev:vite": "vite",
    "api": "cargo run --release --manifest-path backend/Cargo.toml --bin studio-api --",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test \"tests/*.test.mjs\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "pixelarticons": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
