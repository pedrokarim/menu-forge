{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedrokarim.github.io/menu-forge/menu.schema.json",
  "title": "Menu de Menu Forge (*.menu.json, version 1)",
  "description": "Contrat entre le studio (qui l’écrit) et la lib Java (qui le lit) ; spécification lisible : docs/format.md. Le schéma décrit ce que le studio écrit : il refuse les clés inconnues, que la lib se contente d’ignorer. Les règles qui croisent plusieurs fichiers (gabarits, composants, états cités par les conditions et les actions) sont vérifiées par la lib après résolution (MenuValidator).",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1, "description": "Version du format ; 1 si absente." },
    "id": { "$ref": "#/$defs/menuId", "description": "Identifiant unique, sert aussi de nom de police." },
    "name": { "type": "string", "description": "Nom lisible (outil, journaux) ; l’identifiant si absent." },
    "template": { "type": "boolean", "description": "Gabarit partiel, hérité via extends ; jamais ouvert seul." },
    "component": { "type": "boolean", "description": "Composant réutilisable, inclus via includes ; jamais ouvert seul." },
    "extends": {
      "type": "array",
      "description": "Gabarits hérités, appliqués dans l’ordre (§ Gabarits).",
      "items": { "$ref": "#/$defs/menuId" }
    },
    "includes": {
      "type": "array",
      "description": "Instances de composants, sous les éléments propres du menu (§ Composants).",
      "items": { "$ref": "#/$defs/include" }
    },
    "container": { "$ref": "#/$defs/container" },
    "state": {
      "type": "object",
      "description": "Variables d’état du menu, par nom (§ État).",
      "propertyNames": { "pattern": "^[A-Za-z0-9_]+$" },
      "additionalProperties": { "$ref": "#/$defs/stateDefinition" }
    },
    "layers": { "type": "array", "description": "Images du titre, de bas en haut.", "items": { "$ref": "#/$defs/layer" } },
    "texts": { "type": "array", "description": "Textes dynamiques du titre.", "items": { "$ref": "#/$defs/text" } },
    "slots": { "type": "array", "description": "Zones de slots et leur comportement.", "items": { "$ref": "#/$defs/slot" } },
    "form": { "$ref": "#/$defs/form" }
  },
  "if": { "required": ["form"] },
  "then": {
    "description": "Un formulaire Bedrock n’est pas un coffre : ni conteneur, ni couches, textes ou slots, ni gabarits ou composants.",
    "properties": {
      "container": false,
      "layers": false,
      "texts": false,
      "slots": false,
      "extends": false,
      "includes": false,
      "template": false,
      "component": false
    }
  },
  "$defs": {
    "formLayout": {
      "description": "Disposition du pack mcrs_ui (drapeau de titre §m§…), cf. docs/format.md § Formulaire Bedrock.",
      "enum": ["grid", "image_grid", "square_image", "store", "left_button", "bottom_button", "motd", "wrapped"]
    },
    "formIcon": {
      "description": "Image d’un bouton : une seule des trois clés.",
      "oneOf": [
        {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": { "path": { "type": "string", "pattern": "^textures/", "description": "Texture Bedrock (vanilla ou d’un pack du serveur), sans extension." } }
        },
        {
          "type": "object",
          "required": ["texture"],
          "additionalProperties": false,
          "properties": { "texture": { "type": "string", "pattern": "\\.png$", "description": "PNG de l’espace (relatif à textures/), copié dans le pack Menu Forge." } }
        },
        {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": { "url": { "type": "string", "pattern": "^https?://", "description": "Image téléchargée par le client." } }
        }
      ]
    },
    "formButton": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/elementId" },
        "text": { "type": "string", "description": "Codes §, variables {…}." },
        "subtitle": { "type": "string", "description": "Envoyé après une tabulation." },
        "role": { "enum": ["banner", "special"], "description": "banner : entrée « bannière » (§m§a) ; special : bouton spécial (§m§b)." },
        "icon": { "$ref": "#/$defs/formIcon" },
        "onClick": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "visibleWhen": { "$ref": "#/$defs/condition" }
      }
    },
    "form": {
      "type": "object",
      "description": "Formulaire Bedrock (ModalFormRequest de type form) : pas de rendu Java.",
      "required": ["layout", "title", "buttons"],
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/formLayout" },
        "title": { "type": "string", "description": "Codes §, variables ; le serveur ajoute devant le drapeau de la disposition." },
        "content": { "type": "string", "description": "Texte de contenu (#form_text), lu selon la disposition." },
        "buttons": { "type": "array", "items": { "$ref": "#/$defs/formButton" } }
      }
    },
    "menuId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "elementId": { "type": "string", "minLength": 1 },
    "stateValue": { "type": ["string", "number", "boolean"] },
    "hexColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "container": {
      "type": "object",
      "required": ["rows"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chest" },
        "rows": { "type": "integer", "minimum": 1, "maximum": 6 }
      }
    },
    "stateDefinition": {
      "oneOf": [
        {
          "type": "object",
          "description": "Une valeur parmi values.",
          "required": ["type", "values", "default"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "enum" },
            "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "default": { "type": "string" }
          }
        },
        {
          "type": "object",
          "description": "Vrai ou faux.",
          "required": ["type", "default"],
          "additionalProperties": false,
          "properties": { "type": { "const": "bool" }, "default": { "type": "boolean" } }
        },
        {
          "type": "object",
          "description": "Entier, ramené dans [min, max] quand ils sont donnés.",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "int" },
            "default": { "type": "integer" },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "description": "Page courante de la liste list ; expose <nom>.number, <nom>.count, <nom>.hasPrev, <nom>.hasNext.",
          "required": ["type", "list"],
          "additionalProperties": false,
          "properties": { "type": { "const": "page" }, "list": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "condition": {
      "description": "Condition d’affichage ou d’activation (§ Conditions).",
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "is"],
          "additionalProperties": false,
          "properties": { "state": { "type": "string", "minLength": 1 }, "is": { "$ref": "#/$defs/stateValue" } }
        },
        {
          "type": "object",
          "required": ["state", "in"],
          "additionalProperties": false,
          "properties": {
            "state": { "type": "string", "minLength": 1 },
            "in": { "type": "array", "items": { "$ref": "#/$defs/stateValue" } }
          }
        },
        {
          "type": "object",
          "required": ["flag"],
          "additionalProperties": false,
          "properties": { "flag": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["all"],
          "additionalProperties": false,
          "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "required": ["any"],
          "additionalProperties": false,
          "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "required": ["not"],
          "additionalProperties": false,
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "editorFlags": {
      "type": "object",
      "description": "Métadonnée du studio, ignorée par la lib.",
      "additionalProperties": false,
      "properties": { "locked": { "type": "boolean" }, "hidden": { "type": "boolean" } }
    },
    "slotArea": {
      "type": "object",
      "required": ["col", "row"],
      "additionalProperties": false,
      "properties": {
        "col": { "type": "integer", "minimum": 0, "maximum": 8 },
        "row": { "type": "integer", "minimum": 0, "maximum": 5 },
        "width": { "type": "integer", "minimum": 1, "maximum": 9 },
        "height": { "type": "integer", "minimum": 1, "maximum": 6 }
      }
    },
    "generator": {
      "type": "object",
      "description": "Paramètres d’une texture générée par le studio (métadonnée libre, ignorée par la lib ; forme écrite par le studio ci-dessous).",
      "properties": {
        "style": {
          "enum": ["panel", "button", "cell", "veil", "flat", "mcrs_panel", "mcrs_border", "mcrs_button", "mcrs_raised", "mcrs_strip", "mcrs_slot", "mcrs_grid", "dark_panel", "dark_slot", "dark_tab", "dark_button", "dark_close", "dark_awning", "dark_row", "dark_badge", "dark_progress", "market_price", "market_chart", "market_stepper", "market_search", "market_depth", "market_listing", "market_timer"]
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "color": { "type": "string" },
        "cells": { "type": "array", "items": { "$ref": "#/$defs/slotArea" } },
        "cellColor": { "type": "string" },
        "cellStyle": { "enum": ["cell", "mcrs_slot", "dark_slot"] },
        "radius": { "type": "integer", "minimum": 0, "maximum": 32, "description": "mc-rs : rayon des coins." },
        "borderWidth": { "type": "integer", "minimum": 0, "maximum": 32, "description": "mc-rs : épaisseur de la bordure." },
        "borderColor": { "type": "string", "description": "mc-rs : couleur de la bordure (sinon calculée)." },
        "accent": { "type": "string", "description": "mc-rs : accent des états survol et pressé." },
        "state": { "enum": ["normal", "hover", "pressed"], "description": "mc-rs : état dessiné d’un bouton." },
        "shadow": { "type": "integer", "minimum": 0, "maximum": 32, "description": "mc-rs : hauteur de l’ombre portée." },
        "tile": { "type": "integer", "minimum": 2, "maximum": 64, "description": "mc-rs : côté des cases de la grille ; sombre à accent : largeur des bandes du store ; Marché : pas de la grille du graphe." },
        "progress": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Sombre à accent : remplissage d’une barre de progression ; Marché : profondeur d’un ordre, temps restant ; en pour cent." },
        "icon": {
          "enum": ["close", "back", "sell", "balance", "help", "prev", "next", "digit_1", "digit_2", "digit_3", "digit_4", "digit_5", "digit_6", "digit_7", "digit_8", "digit_9", "coin", "trend_up", "trend_down", "trend_flat", "search", "clock", "plus", "minus", "check", "sort", "filter", "chart", "auction", "withdraw"],
          "description": "Icône pixel centrée dans le corps du bouton (tous styles)."
        },
        "iconColor": { "type": "string", "description": "Couleur de l’icône (sinon claire ou foncée selon le fond)." }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "texture", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/elementId" },
        "texture": { "type": "string", "pattern": "\\.png$", "description": "Chemin relatif au dossier textures/." },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "visibleWhen": { "$ref": "#/$defs/condition" },
        "generator": { "$ref": "#/$defs/generator" },
        "editor": { "$ref": "#/$defs/editorFlags" }
      }
    },
    "text": {
      "type": "object",
      "description": "Texte du titre ; en jeu, y doit valoir au moins 5 (règle vérifiée par la lib après résolution).",
      "required": ["id", "x", "y", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/elementId" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "align": { "enum": ["left", "center", "right"] },
        "color": { "$ref": "#/$defs/hexColor" },
        "value": { "type": "string", "description": "Texte avec variables {…}." },
        "visibleWhen": { "$ref": "#/$defs/condition" },
        "editor": { "$ref": "#/$defs/editorFlags" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invisible": { "type": "boolean", "description": "Item sans rendu : le bouton est dessiné par une couche." },
        "material": { "type": "string", "description": "Matériau Bukkit (DIAMOND, PLAYER_HEAD…)." },
        "name": { "type": "string", "description": "MiniMessage, variables acceptées." },
        "lore": { "type": "array", "items": { "type": "string" } },
        "head": { "type": "string", "description": "Tête de joueur : {viewer}, pseudo ou UUID." },
        "ref": { "type": "string", "description": "Item créé par l’adaptateur du serveur (ItemFactory)." }
      }
    },
    "action": {
      "description": "Action au clic (§ Actions).",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "menu"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "open" },
            "menu": { "$ref": "#/$defs/menuId" },
            "state": { "type": "object", "additionalProperties": { "$ref": "#/$defs/stateValue" } }
          }
        },
        { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "back" } } },
        { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "close" } } },
        {
          "type": "object",
          "required": ["type", "state", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "setState" },
            "state": { "type": "string", "minLength": 1 },
            "value": { "$ref": "#/$defs/stateValue" }
          }
        },
        {
          "type": "object",
          "required": ["type", "list"],
          "additionalProperties": false,
          "properties": { "type": { "const": "nextPage" }, "list": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["type", "list"],
          "additionalProperties": false,
          "properties": { "type": { "const": "prevPage" }, "list": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["type", "sound"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "sound" },
            "sound": { "type": "string", "minLength": 1 },
            "volume": { "type": "number", "minimum": 0 },
            "pitch": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        {
          "type": "object",
          "required": ["type", "command"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "command" },
            "command": { "type": "string", "minLength": 1 },
            "as": { "enum": ["player", "console"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "id"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "custom" },
            "id": { "type": "string", "minLength": 1 },
            "args": { "type": "object" }
          }
        }
      ]
    },
    "slot": {
      "type": "object",
      "required": ["id", "kind", "area"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/elementId" },
        "kind": { "enum": ["button", "list", "input", "decoration"] },
        "area": { "$ref": "#/$defs/slotArea" },
        "item": { "$ref": "#/$defs/item" },
        "list": { "type": "string", "minLength": 1, "description": "Source de données d’un slot list." },
        "onClick": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "visibleWhen": { "$ref": "#/$defs/condition" },
        "enabledWhen": { "$ref": "#/$defs/condition" },
        "editor": { "$ref": "#/$defs/editorFlags" }
      },
      "if": { "properties": { "kind": { "const": "list" } } },
      "then": { "required": ["list"] }
    },
    "include": {
      "type": "object",
      "description": "Instance d’un composant : ses éléments décalés de col / row cases (18 px par case pour couches et textes, plus x / y), préfixés par prefix, soumis en plus à visibleWhen.",
      "required": ["component"],
      "additionalProperties": false,
      "properties": {
        "component": { "$ref": "#/$defs/menuId" },
        "prefix": { "type": "string", "pattern": "^[a-z0-9_]*$" },
        "col": { "type": "integer", "minimum": -8, "maximum": 8 },
        "row": { "type": "integer", "minimum": -5, "maximum": 5 },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "visibleWhen": { "$ref": "#/$defs/condition" }
      }
    }
  }
}
