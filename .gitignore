# Dépendances et builds
node_modules/
dist/
build/
target/
.gradle/
out/
*.class
__pycache__/

# Bibliothèques d’assets locales (chemins propres à la machine, packs tiers)
libraries.local.json
# Caches du studio (index des bibliothèques)
.cache/

# Contenu de l’espace de travail d’exemple : bac à sable, peut contenir des
# textures importées depuis des packs tiers.
examples/menus/
examples/assets/
examples/textures/
examples/pixels/
# Corbeille de l’espace d’exemple (documents mis à la corbeille par le studio).
examples/.trash/
# Packs ZIP de test écrits par le studio (« Pack ZIP »).
examples/exports/
# Captures d’échec des tests de bout en bout du studio (`npm run e2e`).
studio/e2e/results/
# Pages de documentation du site, générées depuis docs/ par site/scripts/build.py
# (et par le workflow Pages à chaque publication).
site/docs/
site/en/docs/

# Environnement
.env
.env.*
!.env.example

# Éditeurs / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Journaux
*.log
npm-debug.log*

# Notes de travail locales (suivi, idées, références), jamais publiées
.planning/
